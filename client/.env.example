# AI Interview Platform - Client Environment Variables
# Copy to .env.local for local overrides

# API base URL (leave blank to use Vite proxy default '/api' - for dev)
# For production builds pointing to a remote backend:
# VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# WebSocket URL (defaults to same origin as VITE_API_URL if blank)
# VITE_SOCKET_URL=https://api.yourdomain.com
VITE_SOCKET_URL=
