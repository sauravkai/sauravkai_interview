# ==============================================================================
# AI Interview Platform - Server Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# MongoDB Connection String (Atlas or Docker container)
# e.g., mongodb://mongo:27017/ai-interview-platform (Docker Compose)
# e.g., mongodb+srv://<user>:<password>@cluster0.mongodb.net/ai-interview-platform (Cloud Atlas)
MONGO_URI=mongodb+srv://sauravkai2023_db_user:89AqHRd6EtEfHZ1j@sauravkai.czdbt76.mongodb.net/?appName=SAURAVKAI

# JSON Web Token Secret (CRITICAL: Replace with a cryptographically secure 64-char string)
# Command to generate: openssl rand -base64 48
JWT_SECRET=replace_with_strong_crypto_random_jwt_secret_in_production
JWT_EXPIRE=7d

# Allowed CORS Origins (Comma-separated for multiple domains)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173,https://yourdomain.com
CLIENT_URL=http://localhost:3001

# Demo/Mock Authentication (Set to 'false' in production enterprise deployments)
ALLOW_DEMO_LOGIN=false

# Serve Client Build Statically from Server (Single-service deployment mode)
SERVE_STATIC=false

# Max allowed code submission payload size in bytes (default: 65536 = 64KB)
MAX_CODE_LENGTH=65536

# Optional External AI Services
# Google Gemini API Key (for LLM technical answer evaluation)
GEMINI_API_KEY=
# OpenAI API Key (optional)
OPENAI_API_KEY=
# Vapi AI Voice Integration (for voice conversational interviews)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=

# Stripe Payment Gateway
# NOTE: Stripe's support for Indian UPI/QR workflows and INR settlement is limited in some regions.
# If you are deploying for Indian users, prefer Razorpay (below) which provides native UPI/QR/INR support.
# Leave these blank if you will use Razorpay or another local provider instead.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Razorpay Payment Gateway (Recommended for India — INR / UPI / QR)
# Razorpay fully supports Indian payment rails (UPI, netbanking, cards, QR). Use test keys
# from https://dashboard.razorpay.com for development, and production keys for deployment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP / Mailer for Interview Invites
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=AI Interview Platform <your_email@gmail.com>
